<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed"
            prefHeight="620.0" prefWidth="520.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfxsdk.controller.impl.ChangeRequestDetailsViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Title Bar -->
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="520.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="520.0"
                           styleClass="window-title" text="Generate Change Request" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕"
                            AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0"/>
                    <Button fx:id="minimizeButton" mnemonicParsing="false" onAction="#onMinimizeButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-minimize" text="─"
                            AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="5.0"/>
                </children>
            </AnchorPane>

            <!-- Main Content -->
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <VBox spacing="8" fillWidth="true"
                          AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0"
                          AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

                        <Label text="Description" styleClass="label-subtle"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="descriptionPreview" HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false" focusTraversable="false"/>
                            <Button mnemonicParsing="false" onAction="#onEditDescriptionClick" text="Edit"/>
                        </HBox>

                        <Label text="Justification / Business Case" styleClass="label-subtle"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="justificationPreview" HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false" focusTraversable="false"/>
                            <Button mnemonicParsing="false" onAction="#onEditJustificationClick" text="Edit"/>
                        </HBox>

                        <!-- Impacted Components -->
                        <Label text="Impacted Components" styleClass="label-subtle"/>
                        <ListView fx:id="impactedComponentsList" prefHeight="120.0"/>
                        <HBox spacing="6">
                            <Button mnemonicParsing="false" onAction="#onAddImpactClick" text="Add"/>
                            <Button mnemonicParsing="false" onAction="#onRemoveImpactClick" text="Remove"/>
                        </HBox>

                        <Label text="Testing Strategy" styleClass="label-subtle"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="testingStrategyPreview" HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false" focusTraversable="false"/>
                            <Button mnemonicParsing="false" onAction="#onEditTestingStrategyClick" text="Edit"/>
                        </HBox>

                        <Label text="Rollback Plan" styleClass="label-subtle"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="rollbackPlanPreview" HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false" focusTraversable="false"/>
                            <Button mnemonicParsing="false" onAction="#onEditRollbackPlanClick" text="Edit"/>
                        </HBox>

                        <Label text="Approved By" styleClass="label-subtle"/>
                        <TextField fx:id="approvedByField" maxWidth="Infinity" promptText="e.g. Jane Doe"/>

                        <Label text="Approval Date" styleClass="label-subtle"/>
                        <TextField fx:id="approvalDateField" maxWidth="Infinity" promptText="e.g. 2025-07-15"/>

                        <ButtonBar>
                            <buttons>
                                <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onBackButtonClick"
                                        text="Back"/>
                                <Button fx:id="buttonNext" mnemonicParsing="false" onAction="#onNextButtonClick"
                                        text="Next"/>
                                <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancelButtonClick"
                                        text="Cancel"/>
                            </buttons>
                        </ButtonBar>
                    </VBox>
                </ScrollPane>
            </AnchorPane>
        </children>
        <VBox.margin>
            <Insets/>
        </VBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
