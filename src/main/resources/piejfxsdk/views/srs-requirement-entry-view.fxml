<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed"
            prefHeight="240.0" prefWidth="420.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfxsdk.controller.impl.SRSRequirementEntryViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Title Bar -->
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="420.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" prefHeight="17.0" prefWidth="420.0"
                           styleClass="window-title" text="Add Requirement" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕"
                            AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0"/>
                </children>
            </AnchorPane>

            <!-- Main Content -->
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox spacing="8" fillWidth="true"
                      AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0"
                      AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

                    <Label text="ID" styleClass="label-subtle"/>
                    <TextField fx:id="idField" maxWidth="Infinity" promptText="e.g. FR-01"/>

                    <Label text="Requirement" styleClass="label-subtle"/>
                    <TextField fx:id="requirementField" maxWidth="Infinity" promptText="Describe the requirement"/>

                    <Label text="Priority" styleClass="label-subtle"/>
                    <TextField fx:id="priorityField" maxWidth="Infinity" promptText="e.g. High"/>

                    <ButtonBar>
                        <buttons>
                            <Button fx:id="buttonSave" mnemonicParsing="false" onAction="#onSaveButtonClick" text="Save"/>
                            <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancelButtonClick" text="Cancel"/>
                        </buttons>
                    </ButtonBar>
                </VBox>
            </AnchorPane>
        </children>
        <VBox.margin><Insets/></VBox.margin>
    </VBox>
    <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/></padding>
</AnchorPane>
