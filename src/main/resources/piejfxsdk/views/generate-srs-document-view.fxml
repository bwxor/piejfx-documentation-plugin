<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ToggleGroup?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed"
            prefHeight="540.0" prefWidth="520.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfxsdk.controller.impl.GenerateSRSDocumentViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Title Bar -->
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="520.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="520.0"
                           styleClass="window-title" text="Generate SRS Document" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕"
                            AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0"/>
                    <Button fx:id="minimizeButton" mnemonicParsing="false" onAction="#onMinimizeButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-minimize" text="─"
                            AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="5.0"/>
                </children>
            </AnchorPane>

            <!-- Main Content -->
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox spacing="8"
                      fillWidth="true"
                      AnchorPane.topAnchor="10.0"
                      AnchorPane.leftAnchor="10.0"
                      AnchorPane.rightAnchor="10.0"
                      AnchorPane.bottomAnchor="10.0">

                    <!-- Project metadata -->
                    <Label text="Project Name" styleClass="label-subtle"/>
                    <TextField fx:id="projectNameField" maxWidth="Infinity" promptText="e.g. My First Agile Project"/>

                    <Label text="Document Version" styleClass="label-subtle"/>
                    <TextField fx:id="documentVersionField" maxWidth="Infinity" promptText="e.g. 1.0"/>

                    <Label text="Date" styleClass="label-subtle"/>
                    <TextField fx:id="dateField" maxWidth="Infinity" promptText="e.g. 2020-11-14"/>

                    <Label text="Author(s)" styleClass="label-subtle"/>
                    <TextField fx:id="authorsField" maxWidth="Infinity" promptText="e.g. John and Jane Doe"/>

                    <Label text="Status" styleClass="label-subtle"/>
                    <TextField fx:id="statusField" maxWidth="Infinity" promptText="e.g. In Review"/>

                    <!-- Buttons -->
                    <ButtonBar>
                        <buttons>
                            <Button fx:id="buttonNext" mnemonicParsing="false" onAction="#onNextButtonClick"
                                    text="Next"/>
                            <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancelButtonClick"
                                    text="Cancel"/>
                        </buttons>
                    </ButtonBar>
                </VBox>
            </AnchorPane>
        </children>
        <VBox.margin>
            <Insets/>
        </VBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
