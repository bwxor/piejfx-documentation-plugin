<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed"
            prefHeight="560.0" prefWidth="520.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfxsdk.controller.impl.ChangeRequestHeaderViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Title Bar -->
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="520.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="520.0"
                           styleClass="window-title" text="Generate Change Request" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕"
                            AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0"/>
                    <Button fx:id="minimizeButton" mnemonicParsing="false" onAction="#onMinimizeButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-minimize" text="─"
                            AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="5.0"/>
                </children>
            </AnchorPane>

            <!-- Main Content -->
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <VBox spacing="8" fillWidth="true"
                          AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0"
                          AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

                        <Label text="Change ID" styleClass="label-subtle"/>
                        <TextField fx:id="changeIdField" maxWidth="Infinity" promptText="e.g. CR-2025-042"/>

                        <Label text="Title" styleClass="label-subtle"/>
                        <TextField fx:id="titleField" maxWidth="Infinity" promptText="e.g. Migrate auth to OAuth 2.0"/>

                        <Label text="Requested By" styleClass="label-subtle"/>
                        <TextField fx:id="requestedByField" maxWidth="Infinity" promptText="e.g. John Doe"/>

                        <Label text="Request Date" styleClass="label-subtle"/>
                        <TextField fx:id="requestDateField" maxWidth="Infinity" promptText="e.g. 2025-07-01"/>

                        <Label text="Target Version" styleClass="label-subtle"/>
                        <TextField fx:id="targetVersionField" maxWidth="Infinity" promptText="e.g. 3.0.0"/>

                        <Label text="Priority" styleClass="label-subtle"/>
                        <ComboBox fx:id="priorityComboBox" prefHeight="27.0" prefWidth="180.0" value="Medium">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Low"/>
                                    <String fx:value="Medium"/>
                                    <String fx:value="High"/>
                                    <String fx:value="Critical"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Status" styleClass="label-subtle"/>
                        <ComboBox fx:id="statusComboBox" prefHeight="27.0" prefWidth="180.0" value="Proposed">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Proposed"/>
                                    <String fx:value="Under Review"/>
                                    <String fx:value="Approved"/>
                                    <String fx:value="Rejected"/>
                                    <String fx:value="Implemented"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <ButtonBar>
                            <buttons>
                                <Button fx:id="buttonNext" mnemonicParsing="false" onAction="#onNextButtonClick"
                                        text="Next"/>
                                <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancelButtonClick"
                                        text="Cancel"/>
                            </buttons>
                        </ButtonBar>
                    </VBox>
                </ScrollPane>
            </AnchorPane>
        </children>
        <VBox.margin>
            <Insets/>
        </VBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
