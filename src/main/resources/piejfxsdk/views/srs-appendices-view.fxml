<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed"
            prefHeight="540.0" prefWidth="560.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfxsdk.controller.impl.SRSAppendicesViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Title Bar -->
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="560.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="560.0"
                           styleClass="window-title" text="Generate SRS Document" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕"
                            AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0"/>
                    <Button fx:id="minimizeButton" mnemonicParsing="false" onAction="#onMinimizeButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-minimize" text="─"
                            AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="5.0"/>
                </children>
            </AnchorPane>

            <!-- Main Content -->
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox spacing="8"
                      fillWidth="true"
                      AnchorPane.topAnchor="10.0"
                      AnchorPane.leftAnchor="10.0"
                      AnchorPane.rightAnchor="10.0"
                      AnchorPane.bottomAnchor="10.0">

                    <!-- Glossary (Map<String,String>) -->
                    <Label text="Glossary" styleClass="label-subtle"/>
                    <ListView fx:id="glossaryList" prefHeight="160.0" maxWidth="Infinity"
                              onMouseClicked="#onGlossaryListMouseClicked">
                        <placeholder><Label text="No glossary entries added yet."/></placeholder>
                    </ListView>
                    <HBox spacing="6">
                        <Button fx:id="buttonAddGlossary" mnemonicParsing="false" onAction="#onAddGlossaryClick" text="Add"/>
                        <Button fx:id="buttonRemoveGlossary" mnemonicParsing="false" onAction="#onRemoveGlossaryClick" text="Remove"/>
                    </HBox>

                    <!-- Open Issues (List<String>) -->
                    <Label text="Open Issues" styleClass="label-subtle"/>
                    <ListView fx:id="openIssuesList" prefHeight="120.0" maxWidth="Infinity"
                              onMouseClicked="#onOpenIssuesListMouseClicked">
                        <placeholder><Label text="No open issues added yet."/></placeholder>
                    </ListView>
                    <HBox spacing="6">
                        <Button fx:id="buttonAddIssue" mnemonicParsing="false" onAction="#onAddIssueClick" text="Add"/>
                        <Button fx:id="buttonRemoveIssue" mnemonicParsing="false" onAction="#onRemoveIssueClick" text="Remove"/>
                    </HBox>

                    <!-- Navigation buttons -->
                    <ButtonBar>
                        <buttons>
                            <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onBackButtonClick" text="Back"/>
                            <Button fx:id="buttonNext" mnemonicParsing="false" onAction="#onNextButtonClick" text="Next"/>
                            <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancelButtonClick" text="Cancel"/>
                        </buttons>
                    </ButtonBar>
                </VBox>
            </AnchorPane>
        </children>
        <VBox.margin>
            <Insets/>
        </VBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
