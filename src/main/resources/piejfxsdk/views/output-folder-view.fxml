<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed"
            prefHeight="350.0" prefWidth="520.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfxsdk.controller.impl.OutputFolderViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <!-- Title Bar -->
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="520.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="520.0"
                           styleClass="window-title" text="Generate Document" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕"
                            AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0"/>
                    <Button fx:id="minimizeButton" mnemonicParsing="false" onAction="#onMinimizeButtonClick"
                            prefHeight="25.0" prefWidth="40.0" styleClass="button-minimize" text="─"
                            AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="5.0"/>
                </children>
            </AnchorPane>

            <!-- Main Content -->
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <VBox spacing="8" fillWidth="true"
                          AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0"
                          AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

                        <Label text="Watermark File" styleClass="label-subtle"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="watermarkFileField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                       editable="false" promptText="Select an image..."/>
                            <Button fx:id="buttonBrowseWatermarkFile" mnemonicParsing="false"
                                    onAction="#onBrowseWatermarkFileButtonClick"
                                    text="..."/>
                            <Button fx:id="buttonClearWatermarkFile" mnemonicParsing="false"
                                    onAction="#onClearWatermarkFileButtonClick"
                                    text="Clear"/>
                        </HBox>

                        <Label text="Watermark Position" styleClass="label-subtle"/>
                        <ComboBox fx:id="watermarkPositionComboBox" id="comboId" layoutX="210.0" layoutY="108.0"
                                  prefHeight="27.0"
                                  prefWidth="102.0" value="Top-Left">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Top-Left"/>
                                    <String fx:value="Top-Right"/>
                                    <String fx:value="Bottom-Left"/>
                                    <String fx:value="Bottom-Right"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Watermark Scale" styleClass="label-subtle"/>
                        <TextField fx:id="watermarkScaleField" HBox.hgrow="ALWAYS" maxWidth="Infinity" promptText="e.g. 0.25"/>

                        <Label text="Output Folder" styleClass="label-subtle"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="outputFolderField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                       editable="false" promptText="Select a folder..."/>
                            <Button fx:id="buttonBrowseOutputFolder" mnemonicParsing="false"
                                    onAction="#onBrowseOutputFolderButtonClick"
                                    text="..."/>
                        </HBox>

                        <!-- Navigation buttons -->
                        <ButtonBar>
                            <buttons>
                                <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onBackButtonClick"
                                        text="Back"/>
                                <Button fx:id="buttonGenerate" mnemonicParsing="false" onAction="#onGenerateButtonClick"
                                        text="Generate"/>
                                <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancelButtonClick"
                                        text="Cancel"/>
                            </buttons>
                        </ButtonBar>
                    </VBox>
                </ScrollPane>
            </AnchorPane>
        </children>
        <VBox.margin>
            <Insets/>
        </VBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
